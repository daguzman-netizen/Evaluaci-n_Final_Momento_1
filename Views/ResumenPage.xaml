<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Evaluación_Final_Momento_1.Views.ResumenPage"
    Title="Resumen">

    <ScrollView>
        <VerticalStackLayout
            Padding="22"
            Spacing="18">

            <!-- Usuario conectado -->
            <Label
                x:Name="lblUsuario"
                Text="Usuario conectado:"
                FontSize="14"
                TextColor="#2457A6"
                FontAttributes="Bold"/>

            <Label
                Text="RESUMEN DE INSCRIPCIÓN"
                Style="{StaticResource TitleStyle}"/>

            <Label
                Text="Información del estudiante"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#2457A6"/>

            <!-- GRID: 9 FILAS Y 2 COLUMNAS -->
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,*"
                RowSpacing="16"
                ColumnSpacing="10">

                <Label
                    Text="Nombre:"
                    FontAttributes="Bold"
                    Grid.Row="0"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblNombre"
                    Grid.Row="0"
                    Grid.Column="1"/>

                <Label
                    Text="Apellido:"
                    FontAttributes="Bold"
                    Grid.Row="1"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblApellido"
                    Grid.Row="1"
                    Grid.Column="1"/>

                <Label
                    Text="Edad:"
                    FontAttributes="Bold"
                    Grid.Row="2"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblEdad"
                    Grid.Row="2"
                    Grid.Column="1"/>

                <Label
                    Text="Fecha:"
                    FontAttributes="Bold"
                    Grid.Row="3"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblFecha"
                    Grid.Row="3"
                    Grid.Column="1"/>

                <Label
                    Text="Ciudad:"
                    FontAttributes="Bold"
                    Grid.Row="4"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblCiudad"
                    Grid.Row="4"
                    Grid.Column="1"/>

                <Label
                    Text="País:"
                    FontAttributes="Bold"
                    Grid.Row="5"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblPais"
                    Grid.Row="5"
                    Grid.Column="1"/>

                <Label
                    Text="Monto inicial:"
                    FontAttributes="Bold"
                    Grid.Row="6"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblMontoInicial"
                    Grid.Row="6"
                    Grid.Column="1"/>

                <Label
                    Text="Pago mensual:"
                    FontAttributes="Bold"
                    Grid.Row="7"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblPagoMensual"
                    Grid.Row="7"
                    Grid.Column="1"/>

                <Label
                    Text="Pago total:"
                    FontAttributes="Bold"
                    TextColor="#2457A6"
                    Grid.Row="8"
                    Grid.Column="0"/>

                <Label
                    x:Name="lblPagoTotal"
                    FontAttributes="Bold"
                    TextColor="#2457A6"
                    Grid.Row="8"
                    Grid.Column="1"/>

            </Grid>

            <Button
                Text="VOLVER AL REGISTRO"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="BtnVolver_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
