<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Evaluación_Final_Momento_1.Views.LoginPage"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="22"
            VerticalOptions="Center">

            <Label
                Text="ACADEMIA ONLINE"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#2457A6"
                HorizontalOptions="Center"/>

            <Label
                Text="INICIO DE SESIÓN"
                FontSize="20"
                TextColor="Red"
                HorizontalOptions="Center"
                FontAttributes="Bold"/>

            <Label
                Text="Ingresa tus credenciales para continuar"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="Gray"/>

            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,*"
                RowSpacing="20"
                ColumnSpacing="12">

                <Label
                    Text="Usuario:"
                    VerticalOptions="Center"
                    Grid.Row="0"
                    Grid.Column="0"/>

                <Entry
                    x:Name="txtUsuario"
                    Placeholder="Ingrese su usuario"
                    Style="{StaticResource InputStyle}"
                    Grid.Row="0"
                    Grid.Column="1"/>

                <Label
                    Text="Contraseña:"
                    VerticalOptions="Center"
                    Grid.Row="1"
                    Grid.Column="0"/>

                <Entry
                    x:Name="txtContrasena"
                    Placeholder="Ingrese su contraseña"
                    IsPassword="True"
                    Style="{StaticResource InputStyle}"
                    Grid.Row="1"
                    Grid.Column="1"/>

            </Grid>

            <Button
                Text="INICIAR SESIÓN"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="BtnIniciarSesion_Clicked"/>

            <Label
                Text="Sistema de inscripción de cursos online"
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
